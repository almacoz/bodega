# ---------- AI model (OpenAI-compatible chat completions) ----------
# Hosted model recommended for demos and judging. Example: Google AI Studio key.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# Local alternative (not reachable by judges; weaker tag extraction, so memory recall may not fire):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# ---------- PayPal Sandbox (required for the test-payment demo) ----------
# Create a Sandbox REST app at https://developer.paypal.com/dashboard/ and copy the Sandbox credentials.
# The code always targets https://api-m.sandbox.paypal.com; there is no live mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Where PayPal redirects back after approval. Development: http://localhost:3000. Deployed: your public URL.
APP_BASE_URL=http://localhost:3000

# ---------- Channel3 product search (optional) ----------
# https://trychannel3.com — without a key, search shows clearly labeled sample results without prices.
CHANNEL3_API_KEY=

# ---------- Demo flags (public, inlined at build time) ----------
# Shows the visible "Demo: skip a day" control and "Reset demo data" (browser-local clock only).
NEXT_PUBLIC_DEMO_MODE=false
# Similar-intention memory recall is ON by default; set to "false" to disable it.
NEXT_PUBLIC_RECALL_ENABLED=true
