# Ollama OpenAI-compatible endpoint (local)
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b

# PayPal Sandbox (Optional - for demo/hackathon use only)
# Create a Sandbox REST app at developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# App Base URL (Required for PayPal redirect callbacks)
# Development: http://localhost:3000
# Production: https://yourdomain.com
APP_BASE_URL=http://localhost:3000

# Optional demo clock: exposes the visible “skip a day” control
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_RECALL_ENABLED=false
