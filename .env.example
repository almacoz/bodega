# Google AI (Gemini) - Required for AI extraction
# Get free API key at aistudio.google.com (no credit card required)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash

# Alternative models if needed:
# LLM_MODEL=gemini-3.5-flash-lite
# Note: gemini-2.5-flash is deprecated for new API keys

# PayPal Sandbox (Optional - for demo/hackathon use only)
# Create a Sandbox REST app at developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# App Base URL (Required for PayPal redirect callbacks)
# Development: http://localhost:3000
# Production: https://yourdomain.com
APP_BASE_URL=http://localhost:3000
